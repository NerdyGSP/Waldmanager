{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Muss exakt dem Worker-Namen im Cloudflare-Dashboard entsprechen
  "name": "hegewerk",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    // Unterseiten direkt aufrufbar machen (Single Page Application)
    "not_found_handling": "single-page-application"
  }
}
